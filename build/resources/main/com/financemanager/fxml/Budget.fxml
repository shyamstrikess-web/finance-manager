<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.financemanager.controller.BudgetController" spacing="24">
    <HBox alignment="CENTER_LEFT" styleClass="view-header">
        <Label text="Budget" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="10" styleClass="year-nav">
            <Button text="&lt;" onAction="#prevYear" styleClass="year-nav-btn" />
            <Label fx:id="lblYear" text="2026" styleClass="year-display" />
            <Button text="&gt;" onAction="#nextYear" styleClass="year-nav-btn" />
        </HBox>
        <Region prefWidth="16" />
        <Button text="Set Custom Budget" onAction="#addCustomBudget" styleClass="btn-primary" />
    </HBox>
    
    <HBox spacing="32" styleClass="budget-summary-bar">
        <Label fx:id="lblTotalBudgeted" text="Monthly Budgeted: ₹ 0.00" styleClass="summary-label" />
        <Label fx:id="lblTotalSpent" text="Monthly Spent: ₹ 0.00" styleClass="summary-label" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <FlowPane fx:id="budgetGrid" hgap="24" vgap="24" />
    </ScrollPane>
</VBox>
