<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.financemanager.controller.AccountsController" spacing="24">
    <HBox alignment="CENTER_LEFT">
        <Label text="Accounts" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblTotal" text="Total: ₹ 0.00" style="-fx-font-size: 16px; -fx-text-fill: -text-secondary;" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="accountsGrid" hgap="24" vgap="24" />
    </ScrollPane>
</VBox>
