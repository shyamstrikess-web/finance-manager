<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.financemanager.controller.MainController">
    <!-- SIDEBAR -->
    <left>
        <VBox id="sidebar" prefWidth="260" styleClass="sidebar">
            <HBox alignment="CENTER" prefHeight="72" styleClass="sidebar-header">
                <Label text="💰 Expense Manager" />
            </HBox>
            <VBox spacing="4" VBox.vgrow="ALWAYS" style="-fx-padding: 16 0;">
                <Button fx:id="btnDashboard" text="📊 Dashboard" onAction="#showDashboard" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="nav-item"/>
                <Button fx:id="btnTransactions" text="📋 Transactions" onAction="#showTransactions" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="nav-item"/>
                <Button fx:id="btnBudget" text="📅 Budget" onAction="#showBudget" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="nav-item"/>
                <Button fx:id="btnAccounts" text="🏦 Accounts" onAction="#showAccounts" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="nav-item"/>
                <Button fx:id="btnCategories" text="🏷️ Categories" onAction="#showCategories" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="nav-item"/>
            </VBox>
            <VBox alignment="CENTER" style="-fx-padding: 24; -fx-border-color: -border-subtle transparent transparent transparent; -fx-border-width: 1;">
                <Label text="v1.0.0" style="-fx-text-fill: -text-muted; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: -bg-base; -fx-padding: 24;">
            <!-- Child FXMLs will be loaded here -->
        </StackPane>
    </center>
    
    <!-- Floating Action Button (Overlay on bottom right) -->
    <bottom>
        <AnchorPane pickOnBounds="false">
            <Button text="+" onAction="#goToAddTransaction" AnchorPane.bottomAnchor="32" AnchorPane.rightAnchor="32" styleClass="fab" prefWidth="56" prefHeight="56" />
        </AnchorPane>
    </bottom>
</BorderPane>
